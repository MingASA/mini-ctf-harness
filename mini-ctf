#!/usr/bin/env python3
import json,os,pathlib,subprocess,sys,pwd
root=pathlib.Path(__file__).resolve().parent
args=sys.argv[1:]
if os.environ.get('WSL_DISTRO_NAME') and os.environ.get('MINI_CTF_ENTER_MOUNT')=='1' and os.environ.get('MINI_CTF_MOUNT_ENTERED')!='1':
    sys.path.insert(0,str(root/'installer'));from bootstrap import interop_env
    env=interop_env();command=['/mnt/c/Windows/System32/wsl.exe','--distribution',os.environ['WSL_DISTRO_NAME'],'--user','root','--exec','nsenter','--mount=/proc/1/ns/mnt','--','runuser','--user',pwd.getpwuid(os.getuid()).pw_name,'--','env','MINI_CTF_MOUNT_ENTERED=1','WSL_DISTRO_NAME='+os.environ['WSL_DISTRO_NAME'],'WSL_INTEROP='+env.get('WSL_INTEROP',''),'python3',str(root/'mini-ctf'),*args]
    os.chdir('/mnt/c');os.execve(command[0],command,env)

if args[:1]==['install'] or args[:2]==['model','install']:
    forwarded=args[1:] if args[0]=='install' else args[2:]
    if forwarded and not forwarded[0].startswith('-'):forwarded=['--model',forwarded[0],*forwarded[1:]]
    os.execv(sys.executable,[sys.executable,str(root/'installer/bootstrap.py'),*forwarded])
state=root/'.install.json'
if args[:1]==['knowledge']:
    import shutil
    node=json.loads(state.read_text())['node'] if state.exists() else shutil.which('node')
    if not node:raise SystemExit('Knowledge lookup requires Node.js. Install the harness or put Node.js on PATH.')
    os.execv(node,[node,str(root/'offline_harness/src/knowledge/cli.mjs'),*args[1:]])
if not state.exists():raise SystemExit('Run ./mini-ctf install --data-dir /path/to/data first.')
s=json.loads(state.read_text());env=dict(os.environ,MINI_CTF_DATA=s['data_dir'],MINI_CTF_CONFIG=s['config'],TMPDIR=s['workspace']+'/tmp')
env['PATH']=str(pathlib.Path(s['node']).parent)+':'+env.get('PATH','')
action=args[0] if args and args[0] in ['doctor','prepare','skills','run','terminal','guard','update'] else 'start'
extra=args[1:] if args and args[0]==action else args
if action not in ['doctor','skills','guard']:
    kind=subprocess.check_output(['findmnt','-n','-o','FSTYPE','-T',s['workspace']],text=True).strip()
    if kind in ['9p','drvfs','ntfs','fuseblk']:
        if os.environ.get('WSL_DISTRO_NAME') and os.environ.get('MINI_CTF_MOUNT_ENTERED')!='1':
            os.environ['MINI_CTF_ENTER_MOUNT']='1';os.execv(sys.executable,[sys.executable,str(root/'mini-ctf'),*args])
        subprocess.run([sys.executable,str(root/'installer/ensure_storage.py')],check=True,env=env)
if action=='update':os.execve(sys.executable,[sys.executable,str(root/'installer/update.py'),*extra],env)
os.chdir(root/'offline_harness');os.execve(s['node'],[s['node'],'src/cli.mjs',action,*extra],env)
