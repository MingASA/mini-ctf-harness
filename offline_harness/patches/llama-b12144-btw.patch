+    bool ctf_btw_has_headroom(uint64_t extra = 0, uint64_t * available = nullptr) {
+        if (!params_base.ctf_btw_reserve) return true;
+        ctf_kv_headroom stats;
+        if (!llama_memory_get_cell_stats(llama_get_memory(ctx_tgt), ctf_kv_headroom::receive, &stats)) return false;
+        if (ctx_dft && !llama_memory_get_cell_stats(llama_get_memory(ctx_dft), ctf_kv_headroom::receive, &stats)) return false;
+        // Leave room for a whole target and draft batch, including speculative
+        // tokens, between successive checks. Admission fails closed.
+        if (available) *available = stats.saw_attention ? stats.free_min : 0;
+        return stats.saw_attention && stats.free_min > ctf_btw_required_cells() + extra;
+    }
+
+    // Mirror the checkpoint selection used when starting a prompt. The result
+    // is a conservative lower bound on the prefix that can be reused without
+    // rewinding a recurrent state. If no checkpoint qualifies, budget for a
+    // complete prefill instead of repeatedly evicting and retrying a branch.
+    size_t ctf_btw_reusable(const server_slot & source, const server_task & task) const {
+        size_t n_past = source.prompt.tokens.get_common_prefix(task.tokens);
+        if (!n_past) return 0;
+        const llama_pos pos_next = source.prompt.tokens.pos_next(n_past);
+        const llama_pos pos_eval = pos_next - (n_past < task.tokens.size() ? 0 : 1);
+        const llama_pos threshold = std::max(0, n_swa > 0 ? pos_eval - n_swa + 2 : pos_eval);
+        const llama_pos pos_min = llama_memory_seq_pos_min(llama_get_memory(ctx_tgt), source.id);
+        if (pos_min < 0) return 0;
+        if (pos_min < threshold) return n_past;
+        for (auto it = source.prompt.checkpoints.rbegin(); it != source.prompt.checkpoints.rend(); ++it) {
+            const auto & ckpt = **it;
+            if (ckpt.pos_max > pos_next || !(ckpt.pos_min < threshold || ckpt.pos_min == 0)) continue;
+            const llama_pos pos = std::min(pos_next, std::max(ckpt.pos_min + 1, ckpt.pos_max));
+            return std::min(n_past, std::min(source.prompt.tokens.size_up_to_pos(pos), (size_t) ckpt.n_tokens));
+        }
+        return 0;
+    }
