+    void ctf_btw_protect_main() {
+        if (!params_base.ctf_btw_reserve || slots.size() != 2) return;
+        auto & branch = slots[1];
+        if (!branch.is_processing() && branch.prompt.n_tokens() == 0) return;
+        if (ctf_btw_has_headroom()) return;
+        if (branch.is_processing()) {
+            send_error(branch, "CTF_BTW_WAIT: KV headroom reserved for main slot");
+            branch.release();
+        }
+        // Full-sequence removal drops only this sequence's memberships in
+        // both target and draft contexts, leaving shared cells owned by main.
+        branch.prompt_clear();
+    }
