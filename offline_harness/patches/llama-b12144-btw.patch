+// The observation callback runs on the scheduler thread. Test every attention
+// pool, including the independently allocated MTP draft pool; recurrent state
+// has a different, per-sequence capacity and is not measured in token cells.
+struct ctf_kv_headroom {
+    bool saw_attention = false;
+    uint64_t free_min = UINT64_MAX;
+
+    static void receive(const llama_memory_stat_event * event, void * user_data) {
+        if (event->event_type != LLAMA_MEMORY_STAT_POOL || !event->kind) return;
+        const std::string kind(event->kind);
+        if (kind != "attention" && kind != "attention_swa") return;
+        auto & self = *static_cast<ctf_kv_headroom *>(user_data);
+        self.saw_attention = true;
+        self.free_min = std::min(self.free_min, event->capacity_cells - event->occupied_cells);
+    }
+};
