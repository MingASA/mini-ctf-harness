--- /dev/null
+++ b/include/llama-memory-stats.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include "llama.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Local read-only diagnostic extension. Call only while the context is idle or
+// on its model-execution thread. All callback pointers expire on return.
+enum llama_memory_stat_event_type {
+    LLAMA_MEMORY_STAT_POOL,
+    LLAMA_MEMORY_STAT_MEMBERSHIP,
+    LLAMA_MEMORY_STAT_TENSOR,
+    LLAMA_MEMORY_STAT_BUFFER,
+};
+
+struct llama_memory_stat_event {
+    enum llama_memory_stat_event_type event_type;
+    const void * pool_identity;
+    const void * storage_identity;
+    const char * kind;
+    const char * name;
+    int32_t stream;
+    int32_t layer_id;
+    uint64_t capacity_cells;
+    uint64_t occupied_cells;
+    uint64_t shared_cells;
+    uint64_t exclusive_cells;
+    uint64_t bytes;
+    uint64_t rollback_states_per_sequence;
+    const llama_seq_id * sequence_ids;
+    size_t sequence_count;
+};
+
+typedef void (*llama_memory_stat_callback)(const struct llama_memory_stat_event * event, void * user_data);
+
+// Returns false if one or more memory modules do not implement cell statistics.
+// Modules without telemetry must never be interpreted as an empty pool.
+LLAMA_API bool llama_memory_get_cell_stats(llama_memory_t memory, llama_memory_stat_callback callback, void * user_data);
+
+#ifdef __cplusplus
+}
+#endif
