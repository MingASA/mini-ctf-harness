+
+// Statistics are emitted synchronously by the caller's model-execution thread.
+bool llama_memory_get_cell_stats(llama_memory_t memory, llama_memory_stat_callback callback, void * user_data) {
+    if (!memory || !callback) {
+        return false;
+    }
+    const bool supported = memory->cell_stats(callback, user_data);
+    for (const auto & item : memory->memory_breakdown()) {
+        llama_memory_stat_event event{};
+        event.event_type = LLAMA_MEMORY_STAT_BUFFER;
+        event.name = ggml_backend_buft_name(item.first);
+        event.bytes = item.second;
+        callback(&event, user_data);
+    }
+    return supported;
+}
