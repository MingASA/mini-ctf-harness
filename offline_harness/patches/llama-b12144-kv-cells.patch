+    std::map<std::vector<llama_seq_id>, uint64_t> groups;
+    for (const auto & cell : cells) {
+        if (!cell.is_empty()) {
+            groups[std::vector<llama_seq_id>(cell.seq_id.begin(), cell.seq_id.end())]++;
+        }
+    }
+    llama_memory_stat_event event{};
+    event.event_type = LLAMA_MEMORY_STAT_POOL;
+    event.pool_identity = this;
+    event.kind = "recurrent";
+    event.capacity_cells = cells.size();
+    event.rollback_states_per_sequence = n_rs_seq;
+    for (const auto & item : groups) {
+        event.occupied_cells += item.second;
+        if (item.first.size() > 1) {
+            event.shared_cells += item.second;
+        } else {
+            event.exclusive_cells += item.second;
+        }
+    }
+    callback(&event, user_data);
+    event.event_type = LLAMA_MEMORY_STAT_MEMBERSHIP;
+    for (const auto & item : groups) {
+        event.sequence_ids = item.first.data();
+        event.sequence_count = item.first.size();
+        event.occupied_cells = item.second;
+        callback(&event, user_data);
+    }
+    event.sequence_ids = nullptr;
+    event.sequence_count = 0;
+    event.event_type = LLAMA_MEMORY_STAT_TENSOR;
+    for (size_t il = 0; il < r_l.size(); ++il) {
+        event.layer_id = il;
+        for (const auto & tensor : {std::make_pair("r", r_l[il]), std::make_pair("s", s_l[il]), std::make_pair("p", p_l[il])}) {
+            if (!tensor.second) {
+                continue;
+            }
+            event.name = tensor.first;
+            event.storage_identity = tensor.second->data;
+            event.bytes = ggml_nbytes(tensor.second);
+            callback(&event, user_data);
+        }
+    }
+    return true;
+}
