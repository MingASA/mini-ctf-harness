 }
+
+bool llama_kv_cache::cell_stats(llama_memory_stat_callback callback, void * user_data) const {
+    if (layers.empty()) {
+        return true;
+    }
+    for (uint32_t stream = 0; stream < v_cells.size(); ++stream) {
+        const auto & cells = v_cells[stream];
+        std::map<std::vector<llama_seq_id>, uint64_t> groups;
+        for (uint32_t i = 0; i < cells.size(); ++i) {
+            if (cells.is_empty(i)) {
+                continue;
+            }
+            const auto & ids = cells.seq_get_all(i);
+            std::vector<llama_seq_id> members;
+            const size_t member_count = ids.count();
+            // Include internal speculative sequences, stopping after the last
+            // set bit so a single-slot snapshot visits only sequence zero.
+            for (llama_seq_id seq = 0; seq < LLAMA_MAX_SEQ && members.size() < member_count; ++seq) {
+                if (ids.test(seq)) {
+                    members.push_back(seq);
+                }
+            }
+            groups[std::move(members)]++;
+        }
+        llama_memory_stat_event event{};
+        event.event_type = LLAMA_MEMORY_STAT_POOL;
+        event.pool_identity = &cells;
+        event.kind = n_swa ? "attention_swa" : "attention";
+        event.stream = stream;
+        event.capacity_cells = cells.size();
+        for (const auto & item : groups) {
+            event.occupied_cells += item.second;
+            if (item.first.size() > 1) {
+                event.shared_cells += item.second;
+            } else {
+                event.exclusive_cells += item.second;
+            }
+        }
+        callback(&event, user_data);
+        event.event_type = LLAMA_MEMORY_STAT_MEMBERSHIP;
+        for (const auto & item : groups) {
+            event.sequence_ids = item.first.data();
+            event.sequence_count = item.first.size();
+            event.occupied_cells = item.second;
+            callback(&event, user_data);
+        }
+        event.sequence_ids = nullptr;
+        event.sequence_count = 0;
+        event.event_type = LLAMA_MEMORY_STAT_TENSOR;
+        // A physical layer can serve several model layer IDs. Emit all bindings
+        // with the same storage identity so consumers can avoid double counting.
+        std::map<int32_t, int32_t> ordered_layers(map_layer_ids.begin(), map_layer_ids.end());
+        for (const auto & binding : ordered_layers) {
+            const auto & layer = layers[binding.second];
+            event.layer_id = binding.first;
+            for (const auto & tensor : {std::make_pair("k", layer.k_stream[stream]), std::make_pair("v", layer.v_stream[stream])}) {
+                if (!tensor.second) {
+                    continue;
+                }
+                event.name = tensor.first;
+                event.bytes = ggml_nbytes(tensor.second);
+                event.storage_identity = tensor.second->data;
+                callback(&event, user_data);
+            }
+        }
+    }
+    return true;
+}
