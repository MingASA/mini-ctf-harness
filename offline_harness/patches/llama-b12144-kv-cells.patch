diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index 06e218b..d2987b9 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -3098,3 +3098,71 @@ void llama_kv_cache_context::set_input_pos_bucket(ggml_tensor * dst, const llama
